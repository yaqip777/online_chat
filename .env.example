# ==============================================================
# ONLINE CHAT - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================

# PostgreSQL ma'lumotlar bazasi URL manzili (asyncpg drayveri talab qilinadi)
# Docker Compose da ishlatilsa: postgresql+asyncpg://postgres:postgres@db:5432/online_chat
# Standart serverda ishlatilsa: postgresql+asyncpg://postgres:parol@localhost:5432/online_chat
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@db:5432/online_chat

# JWT Token xavfsizlik kalitlari
# Ushbu kalitlarni yangilash uchun terminalda bajaring:
# openssl rand -hex 32
ACCESS_SECRET_KEY=generate_with_openssl_rand_hex_32
REFRESH_SECRET_KEY=generate_with_openssl_rand_hex_32
ALGORITHM=HS256

# Tokenlarning amal qilish muddati
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS ruxsat berilgan domenlar (vergul bilan ajratilgan yoki JSON array)
# Masalan: ["https://chat.domain.uz", "http://localhost:3000"]
CORS_ORIGINS=["*"]
